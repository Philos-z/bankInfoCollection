# Codex CLI proxy (OpenAI-compatible)
AI_BASE_URL=http://YOUR_PROXY_HOST:8317/v1
AI_API_KEY=<client key from proxy config.yaml api-keys>
AI_MODEL=gpt-5.6-sol
AI_MAX_CONCURRENCY=1
AI_TIMEOUT=180
AI_HTTP_RETRIES=2
AI_RETRY_BASE_SECONDS=2

DB_PATH=data/bank_campaigns.db
SNAPSHOT_DIR=data/snapshots
USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 14_0) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0 Safari/537.36
REQUEST_DELAY_SECONDS=3
SOURCE_HEALTH_WARNING_FAILURES=3
SOURCE_HEALTH_CRITICAL_FAILURES=5
